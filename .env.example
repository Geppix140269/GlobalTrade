# Copy to .env.local for development, and set the same names in Vercel.
# Never commit real values.

# Pooled PostgreSQL connection, used by the running app.
# Supabase: Project Settings -> Database -> Connection string -> Transaction pooler.
# If the directory shares a Supabase project with another product, keep it in its own
# schema by appending &schema=gtn — the tables then live in "gtn", not "public".
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1&schema=gtn"

# Direct (non-pooled) connection, used by `prisma db push` and `prisma migrate`.
# Supabase: the same screen -> Session pooler / Direct connection (port 5432).
# If your provider has no pooler, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=gtn"

# Secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the deployment. Vercel sets this automatically in production;
# only needed locally.
# NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run create:admin` — not read by the application at runtime.
# Pass them on the command line rather than storing them in a file.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
