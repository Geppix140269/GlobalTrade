# Copy to .env.local for development, and set the same names in Vercel.
# Never commit real values.

# PostgreSQL connection string (Vercel Postgres, Neon, Supabase, ...).
# Use the pooled connection string in production.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the deployment. Vercel sets this automatically in production;
# only needed locally.
# NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run create:admin` — not read by the application at runtime.
# Pass them on the command line rather than storing them in a file.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
