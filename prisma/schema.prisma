// Global Trade Network — Community Directory
// Deliberately light normalisation: two core entities (Member, Opportunity) plus
// login accounts (User). Scalar string arrays are used for markets/expertise so the
// data stays trivially exportable and portable to another store later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection, used by the running app (Supabase pooler / Neon pooled URL).
  url       = env("DATABASE_URL")
  // Direct connection, used by `prisma db push` and `prisma migrate`, which cannot
  // run through a transaction pooler. Set it to the same value as DATABASE_URL if
  // your provider does not use a pooler.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OpportunityStatus {
  OPEN
  IN_PROGRESS
  MATCHED
  CLOSED
  ON_HOLD
}

/// A login account. Exactly one account per member profile.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  /// Admin can disable access without deleting the account or the profile.
  isActive     Boolean  @default(true)
  /// Forces a password change on next login (used for admin-issued credentials).
  mustChangePassword Boolean @default(false)
  /// The single member profile this account may edit. Null for admin-only accounts.
  memberId     String?  @unique
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// An invite code that lets a Community member create their own account.
/// Signup is still closed to the public: no code, no account.
model InviteCode {
  id         String    @id @default(cuid())
  /// The code members type in. Stored uppercase; compared case-insensitively.
  code       String    @unique
  /// What this code is for, e.g. "WhatsApp Community — January".
  label      String    @default("")
  /// Null means unlimited uses.
  maxUses    Int?
  usedCount  Int       @default(0)
  /// Null means it never expires.
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  /// Role granted to whoever signs up with this code. Defaults to MEMBER;
  /// set to ADMIN only for a code handed to one named person, since anyone
  /// holding the code receives the role.
  role       Role      @default(MEMBER)
  /// When set, this is a *claim* code: signing up with it takes ownership of an
  /// existing profile instead of creating a new one. Used to hand seeded
  /// profiles to the people they describe.
  memberId   String?
  member     Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive])
}

/// A Community member profile. Members maintain their own; admin may correct any.
model Member {
  id            String       @id @default(cuid())
  name          String
  company       String       @default("")
  roleTitle     String       @default("")
  baseCountry   String       @default("")
  /// Countries / regions the member covers.
  markets       String[]     @default([])
  /// Free text: what they do.
  whatTheyDo    String       @default("")
  /// Products, services, expertise tags — also used for filtering.
  expertise     String[]     @default([])
  currentFocus  String       @default("")
  lookingFor    String       @default("")
  canOffer      String       @default("")
  website       String       @default("")
  linkedin      String       @default("")
  email         String       @default("")
  phone         String       @default("")
  status        MemberStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User?
  /// Opportunities this member raised.
  requests      Opportunity[] @relation("OpportunityRequester")
  /// Opportunities this member could contribute to (supplier, buyer, logistics, ...).
  relevantFor   Opportunity[] @relation("OpportunityRelevantMembers")
  /// Claim codes issued for this profile.
  claimCodes    InviteCode[]

  @@index([status])
  @@index([baseCountry])
}

/// An active request / opportunity curated by the admin from Community conversation.
model Opportunity {
  id             String            @id @default(cuid())
  dateAdded      DateTime          @default(now())
  /// Denormalised requester name/company so a request survives profile changes.
  requesterName  String
  requesterCompany String          @default("")
  requesterId    String?
  requester      Member?           @relation("OpportunityRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  type           String            @default("")
  market         String            @default("")
  request        String
  supportNeeded  String            @default("")
  notes          String            @default("")
  status         OpportunityStatus @default(OPEN)
  /// Members who could contribute a piece of this opportunity.
  relevantMembers Member[]         @relation("OpportunityRelevantMembers")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
}
